<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- 120 MB limit in bytes (125,829,120) to allow a 100 MB media file + 10 MB thumbnail + multipart overhead on IIS without 413/404.13 error -->
          <requestLimits maxAllowedContentLength="125829120" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
