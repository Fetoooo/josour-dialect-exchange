{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<NEON_HOST>;Port=5432;Database=<DB_NAME>;Username=<DB_USER>;Password=<DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true;"
  },
  "Jwt": {
    "Key": "<MINIMUM_64_CHARACTERS_SECURE_RANDOM_SECRET_KEY>",
    "Issuer": "DialectExchangeAPI",
    "Audience": "DialectExchangeApp",
    "ExpiryHours": 2
  },
  "FrontendBaseUrl": "http://localhost:4200",
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "<YOUR_SMTP_EMAIL_ADDRESS>",
    "FromAddress": "noreply@josour.app",
    "Password": "<YOUR_SMTP_APP_PASSWORD>"
  },
  "Cloudinary": {
    "CloudName": "<YOUR_CLOUDINARY_CLOUD_NAME>",
    "ApiKey": "<YOUR_CLOUDINARY_API_KEY>",
    "ApiSecret": "<YOUR_CLOUDINARY_API_SECRET>"
  },
  "OpenRouter": {
    "ApiKey": "<YOUR_OPENROUTER_API_KEY>",
    "Model": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "FallbackModel": "nvidia/nemotron-3.5-lightning:free",
    "BaseUrl": "https://openrouter.ai/api/v1/"
  },
  "Turn": {
    "Server": "",
    "Username": "",
    "Credential": "",
    "Secret": "",
    "TokenExpiryHours": 24
  },
  "ForwardedHeaders": {
    "TrustedProxies": [],
    "TrustedNetworks": [],
    "ForwardLimit": 1
  }
}
