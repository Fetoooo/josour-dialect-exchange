# ==============================================================================
# Josour (جُسور) — Environment Configuration Template
# Copy this file to .env or .env.local and populate with your own credentials.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# PostgreSQL Connection (Neon Lakebase Serverless or Local)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require"
NEON_BRANCH="development"

# JWT Authentication
JWT_KEY="<MINIMUM_64_CHARACTERS_SECURE_RANDOM_SECRET_KEY>"
JWT_ISSUER="DialectExchangeAPI"
JWT_AUDIENCE="DialectExchangeApp"

# Cloudinary Cloud Storage (Optional - falls back to local disk if omitted)
CLOUDINARY_CLOUD_NAME="<YOUR_CLOUDINARY_CLOUD_NAME>"
CLOUDINARY_API_KEY="<YOUR_CLOUDINARY_API_KEY>"
CLOUDINARY_API_SECRET="<YOUR_CLOUDINARY_API_SECRET>"

# OpenRouter AI API (Optional)
OPENROUTER_API_KEY="<YOUR_OPENROUTER_API_KEY>"

# SMTP Email Delivery (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="<YOUR_EMAIL>"
SMTP_PASSWORD="<YOUR_APP_PASSWORD>"
SMTP_FROM="noreply@josour.app"
